# release 签名配置模板。
# 复制为 keystore.properties（该文件已在 .gitignore 忽略，切勿入库），填入真实值。
#
# 生成 keystore 示例：
#   keytool -genkeypair -v -keystore powerinfo-release.jks \
#     -alias powerinfo -keyalg RSA -keysize 2048 -validity 36500

# 相对项目根目录的 keystore 路径（也可用绝对路径）。
storeFile=powerinfo-release.jks
storePassword=your_store_password
keyAlias=powerinfo
keyPassword=your_key_password
